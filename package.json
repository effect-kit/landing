{
  "name": "effect-kit-landing-workspace",
  "private": true,
  "description": "Development workspace for the Effect Kit landing page.",
  "homepage": "https://github.com/effect-kit/landing#readme",
  "bugs": {
    "url": "https://github.com/effect-kit/landing/issues"
  },
  "license": "Apache-2.0",
  "author": {
    "name": "Effect Kit Contributors",
    "url": "https://github.com/effect-kit"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/effect-kit/landing.git"
  },
  "type": "module",
  "scripts": {
    "build": "turbo run build",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "clean": "turbo run clean",
    "dev": "turbo run dev",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint --deny-warnings .",
    "lint:fix": "oxlint --fix .",
    "prepare": "lefthook install",
    "test": "turbo run test",
    "typecheck": "pnpm typecheck:root && turbo run typecheck",
    "typecheck:root": "tsc --noEmit -p tsconfig.json",
    "ci:check": "pnpm check"
  },
  "devDependencies": {
    "@commitlint/cli": "catalog:",
    "@commitlint/config-conventional": "catalog:",
    "@types/node": "catalog:",
    "klarity": "catalog:",
    "lefthook": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "turbo": "catalog:",
    "typescript": "catalog:"
  },
  "engines": {
    "node": ">=24.22.0",
    "pnpm": ">=12.16.1 <13"
  },
  "packageManager": "pnpm@12.16.1"
}
