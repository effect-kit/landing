# Origin for canonical URLs, Open Graph images and the sitemap. Defaults to https://effectkit.dev.
VITE_SITE_URL=https://effectkit.dev

# Optional. Raises GitHub's rate limit for the docs changelogs (read-only, no scopes needed).
GITHUB_TOKEN=

# PostHog project key (public, starts with phc_). Analytics is off without it, and runs only in
# production builds served from effectkit.dev. Put it in .env.local locally.
VITE_POSTHOG_KEY=

# Build only, optional: uploads source maps to PostHog error tracking, then deletes them.
# A personal API key with the "error tracking: write" and "organization: read" scopes.
POSTHOG_PERSONAL_API_KEY=
POSTHOG_PROJECT_ID=695548
